rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Students collection: Auth users can read student profiles, only admin/teachers write
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Classes collection: Auth users can read classes
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Subjects collection: Auth users can read subjects
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Exams and Questions: Auth users can read exams and questions
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';

      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }

    // Attempts: Auth users (including anonymous students) can create, read, and update attempt progress
    match /attempts/{attemptId} {
      allow read, create, update: if request.auth != null;
    }

    // Student Progress: Auth users can read and write progress records
    match /studentProgress/{studentId} {
      allow read, write: if request.auth != null;
    }

    // Users (Teacher accounts): Only non-anonymous auth users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
